# Persistence uses the anon key only, from the browser, as an anonymously-signed-in user under
# Row Level Security -- no service-role key needed; the relay never talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The ESP32 telemetry gateway and Unity command relay will use this endpoint.
NEXT_PUBLIC_REALTIME_GATEWAY_URL=ws://localhost:3001

# Used by `npm run relay`. Replace with the ESP32 IP printed in Serial Monitor.
ESP32_STATE_URL=http://172.20.10.2/state

# mac ipv4 = 172.20.10.3
